{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MarkdownThing",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/MarkdownThing.dll",
            "args": [],
            "cwd": "${workspaceFolder}/bin/Debug/net8.0-windows",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "MarkdownThing (open file)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/MarkdownThing.dll",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}/bin/Debug/net8.0-windows",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
